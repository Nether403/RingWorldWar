{
  "name": "ring-world-war",
  "version": "0.1.0",
  "private": true,
  "description": "A fully procedural 3D real-time strategy game on the inner surface of a rotating ring megastructure.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "node tools/lint.mjs && tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ls12": "playwright test --config playwright.ls12.config.ts",
    "test:e2e:qualify": "node tools/phase4e-qualification.mjs",
    "rww": "node tools/rww.mjs",
    "media:check": "node tools/media/validate-manifests.mjs",
    "media:voices": "node tools/media/generate-voice-lines.mjs",
    "media:images": "node tools/media/generate-images.mjs",
    "media:receipt": "node tools/media/write-delivery-receipt.mjs",
    "validate:core-match": "vitest run --config vitest.core-match.config.ts",
    "check": "npm run lint && npm test && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.3",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
